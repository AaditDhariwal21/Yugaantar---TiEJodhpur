# TEMPLATE ONLY - this file IS committed to git. Put real values in .env
# (gitignored), never here.
#
#   cp .env.example .env    then fill .env in

# Comma-separated list of origins allowed to call this API.
# Add your Vercel production domain, plus any preview/custom domains.
CORS_ORIGIN=http://localhost:5173,https://yugaantar.vercel.app

# Render injects PORT automatically; only set this for local runs.
# PORT=5181


# ---------------------------------------------------------------- database --
# MongoDB Atlas connection string.
#   Atlas > Connect > Drivers > copy, then replace <password>.
#
# IMPORTANT: add the database name before the "?". The string Atlas gives you
# ends in ".mongodb.net/?appName=..." with no database, and Mongo will quietly
# write everything to a database called "test".
#   ...mongodb.net/yugaantar?retryWrites=true&w=majority&appName=...
#
# Atlas also needs 0.0.0.0/0 in Network Access, because Render's free tier has
# no static outbound IP to allowlist.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/yugaantar?retryWrites=true&w=majority


# --------------------------------------------------------- image storage ---
# Cloudflare R2, via its S3-compatible API. Dashboard > R2 > your bucket.
#
# 1. Create a bucket (e.g. yugaantar-media).
# 2. Settings > Public Development URL > Enable. Copy it into R2_PUBLIC_BASE.
#    (Or attach a custom domain and use that instead - r2.dev is rate-limited
#    and Cloudflare does not recommend it for production traffic.)
# 3. Create the S3 credentials. Go via R2, NOT via My Profile > API Tokens -
#    the account-wide token page issues a Bearer token for Cloudflare's REST
#    API, which is not what the S3 client here uses.
#      R2 Object Storage > API > Manage API tokens > Create API token
#      Permission        Object Read & Write
#      Buckets           apply to specific buckets -> the bucket above
#      TTL               No expiration
#      Client IP filter  leave empty - Render's free tier has no static
#                        outbound IP, so any allowlist would break uploads
#    You get an Access Key ID and a Secret Access Key; the secret is shown
#    once. Ignore the S3 endpoint it prints - we build that from
#    R2_ACCOUNT_ID.
# 4. Settings > CORS Policy - REQUIRED, the browser uploads straight to R2 and
#    the presigned PUT is blocked without it:
#      [{ "AllowedOrigins": ["http://localhost:5173", "https://yugaantar.vercel.app"],
#         "AllowedMethods": ["PUT"],
#         "AllowedHeaders": ["content-type"],
#         "MaxAgeSeconds": 3600 }]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yugaantar-media
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxx.r2.dev


# ------------------------------------------------------------- admin gate --
# Leave UNSET and /api/admin is completely open - anyone who finds the URL can
# edit the delegate list and upload to your R2 bucket. Set it to any long
# random string and the API starts requiring an x-admin-key header; the panel
# prompts for it once and remembers it. No frontend redeploy needed either way.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ADMIN_KEY=
