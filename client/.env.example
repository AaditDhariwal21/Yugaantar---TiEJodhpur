# Base URL of the Express API (no trailing slash).
# Unset, the client falls back to http://localhost:5181, which is what
# `npm run dev` in ../server serves — so local development needs no .env.
#
# On Vercel set this to the Render URL, e.g. https://yugaantar-api.onrender.com,
# and remember that Vite inlines it at BUILD time: changing it needs a redeploy,
# not just a restart.
VITE_API_BASE=
